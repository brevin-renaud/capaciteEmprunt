# Base de données Supabase (PostgreSQL)
# Récupérer sur https://supabase.com > Project Settings > Database > Connection String
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Mot de passe admin pour /admin
ADMIN_PASSWORD="votre_mot_de_passe_secret"

# URL du site (optionnel, utilisé pour les redirections absolues)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
